# =============================================================================
# MODÈLE des variables d'environnement — Fondation MIRADEL FEVEPA
# Seul fichier .env versionné. Trois copies réelles, jamais envoyées sur GitHub :
#
#   .env.local       LOCAL      votre PC : npm run dev, tests, base Docker (port 3308)
#   .env.hostinger   HOSTINGER  votre PC -> base MySQL Hostinger (MySQL distant), au besoin
#   .env.production  PRODUCTION à importer dans hPanel > Node.js Web App > Variables
#
# Le site crée et met à jour lui-même ses tables au démarrage (migrations intégrées au code).
# =============================================================================

# Environnement : local | hostinger | production (affiché dans les journaux au démarrage).
APP_ENV=local

# Base MySQL / MariaDB : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# Local : base Docker « miradel-mariadb » (npm run db:local:start), port 3308.
# Production : hôte 127.0.0.1 (MySQL Hostinger n'écoute que sur 127.0.0.1), port 3306.
DATABASE_URL=mysql://miradel:miradel-local@127.0.0.1:3308/miradel

# Dossier persistant des images et PDF envoyés depuis l'admin.
# En production : HORS du dossier de l'application (sinon effacé à chaque déploiement).
# Vide en production = dossier « miradel-uploads » créé à côté de l'application.
UPLOAD_DIR=./uploads

# Adresse publique du site (liens, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3420

# Facultatif : empreinte bcrypt du code de première connexion (création du 1er compte).
# Sans valeur, le code remis par Lean Market s'applique.
SETUP_CODE_HASH=

# Facultatif : premier compte administrateur créé par « npm run db:seed » (10 caractères min.).
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
